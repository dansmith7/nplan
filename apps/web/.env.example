# Open Sunsama Web Environment Variables

# API URL - defaults to /api in development (proxied via Vite)
VITE_API_URL=/api

# Optional: Direct API URL for production
# VITE_API_URL=https://api.opensunsama.com

# WebSocket URL for realtime updates
VITE_WS_URL=ws://localhost:3001
# For production with TLS:
# VITE_WS_URL=wss://api.opensunsama.com

# Supabase browser client. The anon key is safe for the browser; RLS protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
